{
  "schema": 1,
  "language": "python",
  "setup": [
    [
      "python3",
      "-m",
      "venv",
      ".fuzz-venv"
    ],
    [
      ".fuzz-venv/bin/python",
      "-m",
      "pip",
      "install",
      "--require-hashes",
      "--only-binary=:all:",
      "-r",
      ".github/requirements-fuzz.txt"
    ]
  ],
  "targets": [
    {
      "name": "device",
      "engine": "atheris",
      "command": [
        ".fuzz-venv/bin/python",
        "fuzz/fuzz_device.py",
        "-max_len=4096"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/device",
      "instrumentation": [
        {
          "module": "custom_components.desloc.api",
          "functions": [
            "Device.from_json"
          ]
        }
      ]
    }
  ],
  "preflight-paths": [
    ".github/requirements-fuzz.in",
    "custom_components",
    "fuzz",
    "requirements-dev.txt"
  ]
}
