{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>victron-venus/venus-os-ci-toolkit:renovate-fleet"
  ],
  "enabledManagers": [
    "github-actions",
    "custom.regex",
    "custom.jsonata",
    "pip-compile",
    "pip_requirements"
  ],
  "ignorePaths": [
    "**/vendor/**",
    "**/node_modules/**",
    "**/fixtures/**",
    "**/tools/browser-compatibility/**",
    ".github/cosign/**",
    "requirements-dev.txt",
    "scripts/requirements-ci.txt"
  ],
  "packageRules": [
    {
      "description": "Regenerate compiled locks with their recorded source command; avoid independent edits to inputs or output snapshots.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-build.in",
        "requirements-build.txt"
      ],
      "enabled": false
    },
    {
      "description": "These generated locks use compile flags unsupported by the pinned Renovate parser; regenerate them through the documented source workflow.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "requirements-dev.txt"
      ],
      "enabled": false
    },
    {
      "description": "The CI PyYAML hashes are exported from the integration development lock.",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        "scripts/requirements-ci.txt"
      ],
      "enabled": false
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": [
      "/(^|/)([^/]*[-_])?requirements[^/]*\\.(txt|pip)$/"
    ],
    "ignorePaths": [
      "**/vendor/**",
      "**/node_modules/**",
      "**/fixtures/**",
      "**/tools/browser-compatibility/**",
      ".github/cosign/**",
      "requirements-dev.txt",
      "scripts/requirements-ci.txt",
      "requirements-build.in",
      "requirements-build.txt"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/^requirements\\-build\\.txt$/"
    ]
  }
}
